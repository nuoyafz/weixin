# ===== VisReply 源码仓库 .gitignore =====
# 只提交源码、配置模板、文档、构建脚本；排除构建产物、密钥、运行数据、缓存。

# --- Python 缓存 / 编译产物 ---
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# --- 虚拟环境 / 依赖安装目录 ---
venv/
env/
.venv/

# --- PyInstaller 构建产物（onedir / workpath / 安装包） ---
dist/
dist_*/
build/
build_*/
build8/
installer_output/
_build_tmp/

# --- PyInstaller 运行时符号链接（指向本地 _internal，不可移植） ---
_internal

# --- 真实密钥配置：必须忽略，改用 config.example.yaml 模板 ---
config.yaml

# --- 运行数据 / 日志 / 隐私（含 agent.db、聊天记录、线索、截图等） ---
logs/
*.log
data/*
# 例外：RAG 知识库需随仓库分发（不含运行数据库 agent.db / 聊天记录等）
!data/knowledge/
!data/knowledge/**
current_watch/
outputs/
screenshots/
wechat/
_preview/
debug/
diagnostics/
traces/
leads/
materials/

# --- 本地备份 / 临时 / 改名残留 ---
_backup_*/
_trash_*/

# --- 项目本地内存（WorkBuddy memory，含个人偏好，不公开） ---
.workbuddy/

# --- 编辑器 / OS ---
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
.DS_Store
